{
  "name": "training-plan-together",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor",
    "prebuild": "expo prebuild --clean",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"app/**/*.{js,ts,tsx}\" \"__tests__/**/*.{js,ts,tsx}\" \"e2e/**/*.yaml\" \"*.{js,ts}\"",
    "format:check": "prettier --check \"app/**/*.{js,ts,tsx}\" \"__tests__/**/*.{js,ts,tsx}\" \"e2e/**/*.yaml\" \"*.{js,ts}\"",
    "e2e:android": "maestro test -e APP_ID=com.trainingplantogether_cli -e E2E_EMAIL=\"$E2E_EMAIL\" -e E2E_PASSWORD=\"$E2E_PASSWORD\" e2e/",
    "e2e:ios": "maestro test -e APP_ID=com.trainingplantogether-cli -e E2E_EMAIL=\"$E2E_EMAIL\" -e E2E_PASSWORD=\"$E2E_PASSWORD\" e2e/"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/stack": "^7.12.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@types/base-64": "^1.0.0",
    "base-64": "^1.0.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^13.0.0",
    "nanoid": "^3.3.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-countdown-circle-timer": "^3.0.9",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/runtime": "^7.12.5",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^2.6.2",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "main": "index.js"
}
