{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Path to `strict: true` is in docs/testing.md ("TypeScript strictness roadmap").
    // `strict` stays off; the strict-family flags below already pass and are enabled one by one.
    "strict": false,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "strictBuiltinIteratorReturn": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // Cross-folder imports use @<folder>/…; keep in sync with jest.config.js moduleNameMapper.
    "paths": {
      "@assets": ["./app/assets"],
      "@assets/*": ["./app/assets/*"],
      "@common": ["./app/common"],
      "@common/*": ["./app/common/*"],
      "@components": ["./app/components"],
      "@components/*": ["./app/components/*"],
      "@hooks": ["./app/hooks"],
      "@hooks/*": ["./app/hooks/*"],
      "@platform": ["./app/platform"],
      "@platform/*": ["./app/platform/*"],
      "@routers": ["./app/routers"],
      "@routers/*": ["./app/routers/*"],
      "@screens": ["./app/screens"],
      "@screens/*": ["./app/screens/*"],
      "@store": ["./app/store"],
      "@store/*": ["./app/store/*"],
      "@theme": ["./app/theme"],
      "@theme/*": ["./app/theme/*"],
      "@utils": ["./app/utils"],
      "@utils/*": ["./app/utils/*"],
      "@lib": ["./app/lib"],
      "@lib/*": ["./app/lib/*"],
      "@api": ["./app/api"],
      "@api/*": ["./app/api/*"],
      "@services": ["./app/services"],
      "@services/*": ["./app/services/*"],
      "@stores": ["./app/stores"],
      "@stores/*": ["./app/stores/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "admin"]
}
