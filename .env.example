# Copy to .env (gitignored) and fill in for local development. EXPO_PUBLIC_* values are inlined
# into the JS bundle, so never put a real secret here. For EAS builds, set the same keys as EAS
# environment variables in the development / preview / production environments (docs/build.md).

# Firebase web app config (was firebaseSDK in app/Utils/constants.local.ts)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Supabase (target backend, replaces Firebase entity by entity). The anon key is public by design and
# protected by Row Level Security; the service-role key must NEVER be put here or in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In
# OAuth "Web application" client ID of the Firebase project (was GOOGLE_WEB_CLIENT_ID in
# constants.local.ts). Same value for every variant. Form: <number>-<hash>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth "iOS" client ID for the bundle ID of THIS variant (com.trainingplantogether-cli[.dev|.preview]).
# app.config.ts derives the iOS URL scheme from it. Leave empty to build without Google Sign-In on iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time only (not EXPO_PUBLIC_, not bundled)
# development | preview | production (default). eas.json sets it per profile.
APP_VARIANT=development
# EAS project ID printed by `eas init`, if you don't hard-code it in app.config.ts
EAS_PROJECT_ID=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=