{
    "permissions": {
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(*.pem)",
            "Read(*.key)",
            "Read(*.jks)",
            "Read(*.keystore)",
            "Read(*.p8)",
            "Read(*.p12)",
            "Read(./credentials.json)",
            "Read(~/.ssh/**)"
        ],
        "allow": [
            "Bash(npm test:*)",
            "Bash(npm run lint:*)",
            "Bash(npm run format:*)",
            "Bash(npm run test:*)",
            "Bash(npm run doctor:*)",
            "Bash(npx jest:*)",
            "Bash(npx tsc --noEmit:*)",
            "Bash(npx eslint:*)",
            "Bash(npx prettier:*)",
            "Bash(npx expo lint:*)",
            "Bash(npx expo-doctor:*)",
            "Bash(npx expo export:*)",
            "Bash(npx expo install --check:*)",
            "Bash(npx supabase gen types:*)",
            "Bash(npx supabase migration new:*)",
            "Bash(npx supabase status:*)",
            "Bash(git log:*)",
            "Bash(git diff:*)",
            "Bash(git status:*)",
            "Bash(git branch:*)",
            "Bash(git stash list:*)",
            "Bash(git show:*)"
        ]
    }
}
